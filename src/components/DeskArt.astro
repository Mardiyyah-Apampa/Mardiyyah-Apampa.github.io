---
// Large illustrated desktop icons. Usage: <DeskArt name="projects" size={88} />
interface Props {
  name: 'about' | 'projects' | 'log' | 'robotics' | 'resume' | 'contact';
  size?: number;
}
const { name, size = 88 } = Astro.props;
const ink = '#4e2045';
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" stroke={ink} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'about' && (
    <g>
      <rect x="14" y="12" width="72" height="76" rx="8" fill="#f2a5b3" />
      <line x1="40" y1="22" x2="60" y2="22" />
      <rect x="22" y="32" width="56" height="40" rx="4" fill="#fbdde0" />
      <circle cx="36" cy="46" r="5" fill={ink} stroke="none" />
      <path d="M27 64c1.5-7 5-10 9-10s7.5 3 9 10z" fill={ink} stroke="none" />
      <line x1="52" y1="45" x2="70" y2="45" stroke-width="2.5" />
      <line x1="52" y1="53" x2="70" y2="53" stroke-width="2.5" />
      <line x1="52" y1="61" x2="66" y2="61" stroke-width="2.5" />
    </g>
  )}

  {name === 'projects' && (
    <g>
      <path d="M10 26a5 5 0 0 1 5-5h20l6 6h42a5 5 0 0 1 5 5v8H10z" fill="#f6c3c9" />
      <path d="M17 32h66v8H17z" fill="#fffaf3" stroke-width="2.5" />
      <path d="M13 40h80l-8 42a5 5 0 0 1-5 4H13a4 4 0 0 1-4-4V44a4 4 0 0 1 4-4z" fill="#f2a5b3" />
      <rect x="24" y="48" width="18" height="8" rx="1.5" fill="#a7b2dc" stroke-width="2.5" />
    </g>
  )}

  {name === 'log' && (
    <g>
      <rect x="26" y="14" width="60" height="74" rx="5" fill="#8e98c9" />
      <rect x="22" y="10" width="60" height="74" rx="5" fill="#a7b2dc" />
      {[22, 32, 42, 52, 62, 72].map((y) => <line x1="14" y1={y} x2="28" y2={y} stroke-width="3.5" />)}
      <path d="M44 38l-8 9 8 9M60 38l8 9-8 9M55 34l-6 26" stroke-width="3" />
    </g>
  )}

  {name === 'robotics' && (
    <g>
      <line x1="66" y1="40" x2="66" y2="10" stroke-width="2.5" />
      <circle cx="66" cy="9" r="4.5" fill="#f2a5b3" />
      <rect x="36" y="44" width="50" height="22" rx="5" fill="#a8d4a3" />
      <rect x="24" y="30" width="34" height="22" rx="5" fill="#a8d4a3" />
      <rect x="29" y="35" width="24" height="11" rx="3" fill={ink} />
      <circle cx="36" cy="40.5" r="2" fill="#fffaf3" stroke="none" />
      <circle cx="46" cy="40.5" r="2" fill="#fffaf3" stroke="none" />
      <line x1="40" y1="60" x2="62" y2="70" stroke-width="2.5" />
      <ellipse cx="22" cy="72" rx="9" ry="11" fill="#5c5560" />
      <ellipse cx="25" cy="72" rx="4" ry="6" fill="#d9d2c9" />
      <ellipse cx="38" cy="72" rx="5" ry="8" fill="#5c5560" />
      <ellipse cx="68" cy="74" rx="9" ry="11" fill="#5c5560" />
      <ellipse cx="71" cy="74" rx="4" ry="6" fill="#d9d2c9" />
      <ellipse cx="85" cy="74" rx="6" ry="9" fill="#5c5560" />
      <ellipse cx="86" cy="74" rx="2.5" ry="4" fill="#d9d2c9" />
    </g>
  )}

  {name === 'resume' && (
    <g>
      <path d="M22 10h40l18 18v58a4 4 0 0 1-4 4H22a4 4 0 0 1-4-4V14a4 4 0 0 1 4-4z" fill="#fbdde0" />
      <path d="M62 10v14a4 4 0 0 0 4 4h14" fill="#fffaf3" />
      <line x1="30" y1="38" x2="52" y2="38" />
      <line x1="30" y1="50" x2="68" y2="50" />
      <line x1="30" y1="62" x2="68" y2="62" />
      <line x1="30" y1="74" x2="56" y2="74" />
    </g>
  )}

  {name === 'contact' && (
    <g>
      <rect x="10" y="22" width="80" height="58" rx="5" fill="#cf95b3" />
      <path d="M12 26l38 30 38-30" />
      <path d="M14 76l26-22M86 76L60 54" />
    </g>
  )}
</svg>
