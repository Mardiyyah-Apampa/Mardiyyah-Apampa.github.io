---
// The little lab-assistant robot. mood: 'happy' | 'wink'
interface Props {
  size?: number;
  mood?: 'happy' | 'wink';
  class?: string;
}
const { size = 96, mood = 'happy', class: className } = Astro.props;
const ink = '#4e2045';
---

<svg class={className} width={size} height={size} viewBox="0 0 100 100" fill="none" stroke={ink} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <line x1="50" y1="26" x2="50" y2="14" />
  <circle cx="50" cy="11" r="6" fill="#f2a5b3" />
  <rect x="10" y="44" width="10" height="24" rx="4" fill="#a7b2dc" />
  <rect x="80" y="44" width="10" height="24" rx="4" fill="#a7b2dc" />
  <rect x="18" y="26" width="64" height="58" rx="12" fill="#fffaf3" />
  <rect x="27" y="37" width="46" height="34" rx="6" fill={ink} />
  {mood === 'happy' ? (
    <g stroke="#fffaf3" stroke-width="3">
      <path d="M37 58a5 5 0 0 1 10 0" />
      <path d="M53 58a5 5 0 0 1 10 0" />
    </g>
  ) : (
    <g stroke="#fffaf3" stroke-width="3">
      <path d="M37 56h9" />
      <path d="M53 58a5 5 0 0 1 10 0" />
      <path d="M44 64q6 4 12 0" />
    </g>
  )}
</svg>
