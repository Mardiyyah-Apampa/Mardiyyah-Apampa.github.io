---
---

<header class="sticky top-0 z-30 flex items-center justify-between h-10 px-4 bg-paper/90 backdrop-blur border-b-2 border-plum/70 text-[13px] tracking-[0.12em] uppercase">
  <a href="/desktop" class="flex items-center gap-3 hover:text-mauve">
    <span class="block w-4 h-4 bg-plum rounded-[2px]"></span>
    My desktop
  </a>
  <div class="flex items-center gap-4">
    <span class="hidden sm:inline">AI + Robotics</span>
    <span id="clock" class="hidden md:inline tabular-nums text-muted"></span>
    <svg width="18" height="14" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <path d="M2 6a15 15 0 0 1 20 0M5.5 9.5a10 10 0 0 1 13 0M9 13a5 5 0 0 1 6 0" />
      <circle cx="12" cy="16" r="1.2" fill="currentColor" />
    </svg>
    <svg width="24" height="13" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="1" y="1" width="23" height="12" rx="2" />
      <rect x="4" y="4" width="17" height="6" fill="currentColor" stroke="none" />
      <path d="M26 5v4" stroke-linecap="round" />
    </svg>
  </div>
</header>

<script>
  const el = document.getElementById('clock');
  const tick = () => {
    if (el) el.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };
  tick();
  setInterval(tick, 30_000);
</script>
