---
// Decorative circuit traces and axis gizmo for the corners of the desktop.
// Pass corners={false} to show only the top-left traces.
interface Props {
  corners?: boolean;
}
const { corners = true } = Astro.props;
---

<svg class="pointer-events-none absolute left-0 top-4 w-56 h-40 hidden md:block" viewBox="0 0 220 160" fill="none" stroke="#c9bfc5" stroke-width="1.5" aria-hidden="true">
  <path d="M0 105h55l20-20h20l25-25V20" />
  <path d="M0 145h40l30-30 40-40h40" />
  <path d="M38 120h55l60-60h25" />
  <circle cx="120" cy="16" r="4" fill="#fbf6ee" />
  <circle cx="75" cy="85" r="5" fill="#fbf6ee" />
  <circle cx="55" cy="105" r="4" fill="#fbf6ee" />
  <circle cx="153" cy="75" r="4" fill="#fbf6ee" />
  <circle cx="182" cy="60" r="4" fill="#fbf6ee" />
  <circle cx="38" cy="120" r="4" fill="#fbf6ee" />
</svg>

{corners && (
<>
<svg class="pointer-events-none absolute right-6 bottom-28 w-24 h-24 hidden lg:block" viewBox="0 0 100 100" fill="none" stroke="#b9adb6" stroke-width="1.5" font-family="Space Mono, monospace" font-size="12" aria-hidden="true">
  <path d="M40 60V12M40 60h45M40 60L18 82" />
  <path d="M36 18l4-6 4 6M79 56l6 4-6 4M20 74l-2 8 8-2" />
  <text x="46" y="14" fill="#b9adb6" stroke="none">z</text>
  <text x="88" y="66" fill="#b9adb6" stroke="none">y</text>
  <text x="6" y="92" fill="#b9adb6" stroke="none">x</text>
</svg>

<svg class="pointer-events-none absolute right-0 bottom-16 w-72 h-20 hidden md:block" viewBox="0 0 280 80" fill="none" stroke="#c9bfc5" stroke-width="1.5" aria-hidden="true">
  <path d="M40 16h60l30 30h150" />
  <path d="M12 38h80l30 30" />
  <circle cx="40" cy="16" r="4" fill="#fbf6ee" />
  <circle cx="12" cy="38" r="4" fill="#fbf6ee" />
</svg>
</>
)}
