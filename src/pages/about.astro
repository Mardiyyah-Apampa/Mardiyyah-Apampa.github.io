---
// 03 · About me
import DesktopLayout from '../layouts/DesktopLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { site, profile, education, leadership, volunteering } from '../data/site';
---

<DesktopLayout title="About me">
  <Window title="about-me.txt">
    <div class="grid gap-8 md:grid-cols-[240px_1fr]">
      <!-- ID badge -->
      <div class="flex flex-col items-center gap-4 bg-lavender-light/70 border-2 border-plum/20 rounded-md p-6 h-fit">
        <svg width="150" height="190" viewBox="0 0 150 190" fill="none" stroke="#4e2045" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="62" y="4" width="26" height="22" rx="5" fill="#f2a5b3" />
          <circle cx="75" cy="15" r="3.5" fill="#fffaf3" />
          <rect x="12" y="24" width="126" height="160" rx="12" fill="#f2a5b3" />
          <rect x="30" y="46" width="90" height="80" rx="4" fill="#fffaf3" />
          <circle cx="75" cy="76" r="14" fill="#4e2045" />
          <path d="M48 122c3-17 14-24 27-24s24 7 27 24z" fill="#4e2045" />
          <line x1="40" y1="146" x2="110" y2="146" />
          <line x1="52" y1="162" x2="98" y2="162" stroke="#fffaf3" />
        </svg>
        <div class="text-center">
          <p class="font-bold">{site.name}</p>
          <p class="text-xs text-muted mt-1 flex items-center justify-center gap-1"><Icon name="pin" size={12} /> {site.location}</p>
        </div>
      </div>

      <!-- Details -->
      <div class="space-y-7">
        <header>
          <h2 class="text-xl sm:text-2xl font-bold">{profile.headline}</h2>
          <p class="mt-2 text-sm text-muted leading-relaxed">{profile.intro}</p>
        </header>

        <div class="space-y-3 text-sm leading-relaxed">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="cap" /> Education</h3>
          {education.map((e) => (
            <div class="mt-3 pl-7 text-sm">
              <p class="font-bold">{e.degree} · {e.school}</p>
              <p class="text-xs text-muted mt-0.5">{e.dates} · {e.location} · {e.details}</p>
              <div class="flex flex-wrap gap-2 mt-2">
                {e.coursework.map((c) => <span class="chip">{c}</span>)}
              </div>
            </div>
          ))}
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="heart" /> Interests</h3>
          <div class="flex flex-wrap gap-2 mt-3 pl-7">
            {profile.interests.map((i) => <span class="chip chip-pink">{i}</span>)}
          </div>
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="book" /> Currently learning</h3>
          <ul class="mt-3 pl-7 text-sm space-y-1">
            {profile.currentlyLearning.map((c) => <li class="before:content-['▸_'] before:text-mauve">{c}</li>)}
          </ul>
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="star" /> Leadership & volunteering</h3>
          <ul class="mt-3 pl-7 text-sm space-y-2">
            {leadership.map((l) => (
              <li><span class="font-bold">{l.role}</span>, {l.org} <span class="text-xs text-muted">· {l.dates}</span></li>
            ))}
            {volunteering.map((v) => (
              <li><span class="font-bold">{v.role}</span>, {v.org} <span class="text-xs text-muted">· {v.dates}</span></li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </Window>
</DesktopLayout>
