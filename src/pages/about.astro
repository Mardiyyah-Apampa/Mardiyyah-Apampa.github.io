---
// 03 · About me
import { Image } from 'astro:assets';
import DesktopLayout from '../layouts/DesktopLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/me.jpeg';
import { site, profile, education, leadership, volunteering } from '../data/site';
---

<DesktopLayout title="About me">
  <Window title="about-me.txt">
    <div class="grid gap-8 md:grid-cols-[240px_1fr]">
      <!-- ID badge -->
      <div class="flex flex-col items-center gap-4 bg-lavender-light/70 border-2 border-plum/20 rounded-md p-6 h-fit">
        <div class="relative w-[150px] pt-3">
          <!-- Lanyard clip -->
          <div class="absolute left-1/2 -translate-x-1/2 top-0 z-10 grid place-items-center w-7 h-6 bg-pink border-[3px] border-plum rounded-md">
            <span class="w-2 h-2 rounded-full bg-paper border-2 border-plum"></span>
          </div>

          <!-- Card -->
          <div class="bg-pink border-[3px] border-plum rounded-xl px-4 pt-6 pb-4">
            <Image
              src={photo}
              alt={`Photo of ${site.name}`}
              width={240}
              height={280}
              class="w-full aspect-[6/7] object-cover object-top rounded-sm border-[3px] border-plum bg-paper"
            />
            <div class="mt-3 mx-2 h-[3px] bg-plum rounded"></div>
            <div class="mt-2.5 mx-6 h-[3px] bg-paper rounded"></div>
          </div>
        </div>

        <div class="text-center">
          <p class="font-bold">{site.name}</p>
          <p class="mt-1 flex items-center justify-center gap-1 text-xs text-muted">
            <Icon name="pin" size={12} /> {site.location}
          </p>
        </div>
      </div>

      <!-- Details -->
      <div class="space-y-7">
        <header>
          <h2 class="text-xl sm:text-2xl font-bold">{profile.headline}</h2>
          <p class="mt-2 text-sm text-muted leading-relaxed">{profile.intro}</p>
        </header>

        <div class="space-y-3 text-sm leading-relaxed">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="cap" /> Education</h3>
          {education.map((e) => (
            <div class="mt-3 pl-7 text-sm">
              <p class="font-bold">{e.degree} · {e.school}</p>
              <p class="mt-0.5 text-xs text-muted">{e.dates} · {e.location} · {e.details}</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {e.coursework.map((c) => <span class="chip">{c}</span>)}
              </div>
            </div>
          ))}
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="heart" /> Interests</h3>
          <div class="mt-3 pl-7 flex flex-wrap gap-2">
            {profile.interests.map((i) => <span class="chip chip-pink">{i}</span>)}
          </div>
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="book" /> Currently learning</h3>
          <ul class="mt-3 pl-7 space-y-1 text-sm">
            {profile.currentlyLearning.map((c) => (
              <li class="before:content-['▸_'] before:text-mauve">{c}</li>
            ))}
          </ul>
        </section>

        <section>
          <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="star" /> Leadership & volunteering</h3>
          <ul class="mt-3 pl-7 space-y-2 text-sm">
            {leadership.map((l) => (
              <li>
                <span class="font-bold">{l.role}</span>, {l.org}
                <span class="text-xs text-muted">· {l.dates}</span>
              </li>
            ))}
            {volunteering.map((v) => (
              <li>
                <span class="font-bold">{v.role}</span>, {v.org}
                <span class="text-xs text-muted">· {v.dates}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </Window>
</DesktopLayout>