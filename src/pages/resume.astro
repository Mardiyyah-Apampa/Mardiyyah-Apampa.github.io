---
// 07 · Resume
import { getCollection } from 'astro:content';
import DesktopLayout from '../layouts/DesktopLayout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { site, profile, education, experience, skills } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<DesktopLayout title="Resume">
  <Window title="resume.pdf">
    <div class="grid gap-6 md:grid-cols-[110px_1fr]">
      <!-- Page thumbnails -->
      <a href={site.resumePdf} target="_blank" rel="noopener" class="hidden md:flex flex-col gap-3" aria-label="Open the PDF">
        {[0, 1].map((i) => (
          <div class:list={['aspect-[1/1.3] bg-paper border-2 rounded-sm p-2 space-y-1.5', i === 0 ? 'border-mauve bg-lavender-light' : 'border-plum/20']}>
            {[70, 90, 55, 85, 60, 90, 45, 80].map((w) => <div class="h-1 bg-plum/25 rounded" style={`width:${w}%`}></div>)}
          </div>
        ))}
        <span class="text-[10px] text-center text-muted">2 pages</span>
      </a>

      <div>
        <header class="flex flex-wrap items-start justify-between gap-4 pb-5 border-b-2 border-plum/15">
          <div>
            <h2 class="text-3xl tracking-[0.12em] uppercase">{site.name}</h2>
            <p class="text-sm text-muted mt-2 max-w-md">{profile.intro}</p>
            <p class="text-xs mt-2 flex flex-wrap gap-x-4 gap-y-1">
              <a href={`mailto:${site.email}`} class="hover:text-mauve">{site.email}</a>
              <span>{site.location}</span>
            </p>
          </div>
          <a href={site.resumePdf} download class="btn">Download PDF <Icon name="download" size={14} /></a>
        </header>

        <div class="grid gap-8 md:grid-cols-2 mt-6">
          <section>
            <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="cap" /> Education</h3>
            {education.map((e) => (
              <div class="mt-3 text-sm">
                <p class="font-bold">{e.degree}</p>
                <p>{e.school}</p>
                <p class="text-xs text-muted">{e.dates} · {e.details}</p>
              </div>
            ))}
          </section>

          <section>
            <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="folder" /> Projects</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {projects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}`} class="font-bold hover:text-mauve">{p.data.title}</a>
                  <p class="text-xs text-muted">{p.data.tools.join(', ')}</p>
                </li>
              ))}
            </ul>
          </section>

          <section class="md:col-span-2">
            <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="briefcase" /> Experience</h3>
            <div class="mt-3 space-y-5">
              {experience.map((x) => (
                <div class="text-sm">
                  <div class="flex flex-wrap justify-between gap-2">
                    <p><span class="font-bold">{x.role}</span> · {x.company}</p>
                    <p class="text-xs text-muted">{x.dates}</p>
                  </div>
                  <ul class="mt-2 space-y-1.5 text-[13px] leading-relaxed">
                    {x.points.map((pt) => <li class="flex gap-2"><span class="text-mauve">▸</span><span>{pt}</span></li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <section class="md:col-span-2">
            <h3 class="flex items-center gap-2 font-bold text-sm"><Icon name="gear" /> Skills</h3>
            <div class="flex flex-wrap gap-2 mt-3">{skills.technical.map((s) => <span class="chip">{s}</span>)}</div>
            <div class="flex flex-wrap gap-2 mt-2">{skills.soft.map((s) => <span class="chip chip-sage">{s}</span>)}</div>
            <p class="text-xs text-muted mt-3">Languages: {skills.languages.join(' · ')}</p>
          </section>
        </div>
      </div>
    </div>
  </Window>
</DesktopLayout>
